<!-- Star Field Script -->
<script>
  const canvas = document.getElementById('starCanvas');
  const ctx = canvas.getContext('2d');

  function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }
  resize();
  window.addEventListener('resize', () => { resize(); initStars(); });

  const STAR_COUNT = 220;
  let stars = [];

  // Warm gold color palette for stars
  const starColors = [
    'rgba(248, 240, 208, ',  // gold-whisper
    'rgba(232, 208, 128, ',  // gold-light
    'rgba(232, 160, 128, ',  // rose-blush
    'rgba(200, 184, 120, ',  // warm gold
    'rgba(248, 230, 180, ',  // light warm
  ];

  function initStars() {
    stars = [];
    for (let i = 0; i < STAR_COUNT; i++) {
      stars.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        r: Math.random() * 1.2 + 0.2,
        color: starColors[Math.floor(Math.random() * starColors.length)],
        alpha: Math.random() * 0.6 + 0.1,
        speed: Math.random() * 0.004 + 0.001,
        phase: Math.random() * Math.PI * 2,
        type: Math.random() > 0.92 ? 'cross' : 'dot'
      });
    }
  }
  initStars();

  let t = 0;
  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    t += 0.016;

    for (const s of stars) {
      const alpha = s.alpha * (0.5 + 0.5 * Math.sin(t * s.speed * 100 + s.phase));

      if (s.type === 'cross' && s.r > 0.8) {
        // Draw a small 4-pointed star
        ctx.save();
        ctx.translate(s.x, s.y);
        ctx.strokeStyle = s.color + alpha + ')';
        ctx.lineWidth = 0.5;
        const size = s.r * 3;
        ctx.beginPath();
        ctx.moveTo(-size, 0); ctx.lineTo(size, 0);
        ctx.moveTo(0, -size); ctx.lineTo(0, size);
        ctx.stroke();
        ctx.restore();
      }

      ctx.beginPath();
      ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
      ctx.fillStyle = s.color + alpha + ')';
      ctx.fill();
    }

    requestAnimationFrame(draw);
  }
  draw();
</script>

