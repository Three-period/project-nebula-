<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>复古宇宙神秘风 · 配色方案</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&family=Cinzel:wght@400;500;600;700&family=Cormorant:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&display=swap" rel="stylesheet">
<style>
  /* ═══════════════════════════════════════════════
     COSMIC VINTAGE · COLOR SYSTEM
     复古宇宙神秘风 · 完整配色方案
  ═══════════════════════════════════════════════ */

  :root {
    /* ── 背景色族 Background Family ─────────────── */
    --bg-void:     #080604;   /* 虚空黑 · 最深底色 */
    --bg-base:     #0F0B07;   /* 宇宙黑 · 主背景 */
    --bg-surface:  #171108;   /* 星云黑 · 卡片底色 */
    --bg-raised:   #201A0F;   /* 晨曦黑 · 悬浮层 */
    --bg-hover:    #2C2315;   /* 环形暗 · 交互态 */

    /* ── 白金主色族 Whitish Gold · Primary ──────── */
    --gold-whisper: #F8F0D0;  /* 月光白金 · 顶级强调 */
    --gold-ivory:   #F2E8B4;  /* 象牙白金 · 主标题 */
    --gold-light:   #E4D080;  /* 浅金 · 次标题 */
    --gold-main:    #D0B84A;  /* 正金 · 主UI元素 */
    --gold-medium:  #B09430;  /* 中金 · 边框分割 */
    --gold-deep:    #7A6418;  /* 深金 · 纹理细节 */
    --gold-shadow:  #3C3008;  /* 暗金影 · 阴影底 */

    /* ── 铜橙点缀色 Copper Accent · Eye-catching ─ */
    --copper-blaze:  #E86A28;  /* 灼铜 · 最亮点缀 CTA */
    --copper-warm:   #C85820;  /* 暖铜 · 深一档点缀 */
    --copper-amber:  #A04010;  /* 琥珀铜 · 暗部点缀 */

    /* ── 玫瑰金辅助色 Rose Gold · Secondary ─────── */
    --rose-blush:  #E8A080;   /* 玫瑰浅金 · 轻柔高亮 */
    --rose-main:   #C87858;   /* 玫瑰主金 · 辅助强调 */
    --rose-deep:   #9A5840;   /* 玫瑰深金 · 低调辅助 */

    /* ── 文字色 Text Colors ───────────────────── */
    --text-star:      #F8F0D0;  /* 星光白 · 主标题文字 */
    --text-primary:   #E8D8B0;  /* 暖白 · 正文文字 */
    --text-secondary: #B89868;  /* 暖金灰 · 次要文字 */
    --text-muted:     #785C30;  /* 暗金棕 · 说明文字 */
    --text-ghost:     #3A2C14;  /* 幽灵棕 · 极淡文字 */

    /* ── 功能色 Functional ───────────────────── */
    --border-glow:   rgba(208, 184, 74, 0.35);
    --border-subtle: rgba(176, 148, 48, 0.2);
    --glow-gold:     rgba(242, 232, 180, 0.12);
    --glow-copper:   rgba(232, 106, 40, 0.18);
    --shadow-warm:   rgba(12, 8, 4, 0.85);
  }

  /* ─────────────────────────────────────────────
     RESET & BASE
  ───────────────────────────────────────────── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    background-color: var(--bg-base);
    color: var(--text-primary);
    font-family: 'Cormorant Garamond', serif;
    font-size: 16px;
    line-height: 1.7;
    min-height: 100vh;
    overflow-x: hidden;
    cursor: default;
  }

  /* ─────────────────────────────────────────────
     STAR FIELD BACKGROUND
  ───────────────────────────────────────────── */
  .star-field {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .star-field canvas {
    width: 100%;
    height: 100%;
  }

  /* Warm radial gradient overlay */
  .cosmic-overlay {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 40% at 50% 0%, rgba(100, 60, 8, 0.25) 0%, transparent 70%),
      radial-gradient(ellipse 40% 60% at 100% 50%, rgba(80, 40, 4, 0.12) 0%, transparent 60%),
      radial-gradient(ellipse 50% 50% at 0% 80%, rgba(60, 30, 4, 0.1) 0%, transparent 60%);
  }

  /* ─────────────────────────────────────────────
     LAYOUT
  ───────────────────────────────────────────── */
  .page-wrap {
    position: relative;
    z-index: 1;
    max-width: 960px;
    margin: 0 auto;
    padding: 80px 40px 120px;
  }

  /* ─────────────────────────────────────────────
     HEADER
  ───────────────────────────────────────────── */
  .page-header {
    text-align: center;
    margin-bottom: 80px;
    padding-bottom: 60px;
    border-bottom: 1px solid var(--border-subtle);
    position: relative;
  }

  .page-header::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 50%;
    transform: translateX(-50%);
    width: 120px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold-main), transparent);
  }

  .header-eyebrow {
    font-family: 'Cinzel', serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.35em;
    color: var(--copper-warm);
    text-transform: uppercase;
    margin-bottom: 24px;
    opacity: 0.9;
  }

  .page-title {
    font-family: 'Cinzel Decorative', serif;
    font-size: clamp(22px, 4vw, 36px);
    font-weight: 700;
    color: var(--gold-ivory);
    line-height: 1.2;
    margin-bottom: 16px;
    text-shadow: 0 0 40px rgba(242, 232, 180, 0.3);
  }

  .page-subtitle {
    font-family: 'Cormorant', serif;
    font-size: 17px;
    font-style: italic;
    color: var(--text-secondary);
    letter-spacing: 0.05em;
  }

  /* Ornament */
  .ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin: 28px 0;
    color: var(--gold-main);
    font-size: 12px;
    letter-spacing: 0.2em;
  }

  .ornament::before, .ornament::after {
    content: '';
    height: 1px;
    width: 80px;
    background: linear-gradient(90deg, transparent, var(--gold-medium));
  }

  .ornament::after {
    background: linear-gradient(90deg, var(--gold-medium), transparent);
  }

  /* ─────────────────────────────────────────────
     SECTION TITLES
  ───────────────────────────────────────────── */
  .section {
    margin-bottom: 72px;
  }

  .section-label {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.4em;
    color: var(--copper-warm);
    text-transform: uppercase;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .section-label::before {
    content: '';
    display: inline-block;
    width: 20px;
    height: 1px;
    background: var(--copper-warm);
    opacity: 0.7;
  }

  .section-title {
    font-family: 'Cinzel', serif;
    font-size: 20px;
    font-weight: 600;
    color: var(--gold-ivory);
    margin-bottom: 36px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border-subtle);
    position: relative;
  }

  .section-title::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 60px;
    height: 1px;
    background: var(--gold-main);
  }

  /* ─────────────────────────────────────────────
     COLOR PALETTE GRID
  ───────────────────────────────────────────── */
  .palette-group {
    margin-bottom: 48px;
  }

  .palette-group-title {
    font-family: 'Cinzel', serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.3em;
    color: var(--text-muted);
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .palette-row {
    display: flex;
    gap: 0;
    border-radius: 4px;
    overflow: hidden;
    height: 80px;
    margin-bottom: 8px;
    box-shadow: 0 4px 24px var(--shadow-warm);
  }

  .swatch {
    flex: 1;
    position: relative;
    cursor: pointer;
    transition: flex 0.3s ease;
  }

  .swatch:hover {
    flex: 2;
  }

  .swatch-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 6px 8px;
    background: rgba(0,0,0,0.5);
    opacity: 0;
    transition: opacity 0.2s;
    font-family: 'Cinzel', serif;
    font-size: 8px;
    letter-spacing: 0.1em;
    text-align: center;
  }

  .swatch:hover .swatch-info {
    opacity: 1;
  }

  .swatch-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }

  .swatch-tag {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 2px;
    border: 1px solid var(--border-subtle);
    background: var(--bg-surface);
    transition: all 0.2s;
  }

  .swatch-tag:hover {
    border-color: var(--border-glow);
    background: var(--bg-raised);
  }

  .swatch-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .swatch-name {
    font-family: 'Cinzel', serif;
    font-size: 9px;
    letter-spacing: 0.2em;
    color: var(--text-secondary);
  }

  .swatch-hex {
    font-family: 'Cormorant Garamond', serif;
    font-size: 12px;
    color: var(--text-muted);
    margin-left: 4px;
  }

  /* ─────────────────────────────────────────────
     TYPOGRAPHY SHOWCASE
  ───────────────────────────────────────────── */
  .type-showcase {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    padding: 40px 48px;
    position: relative;
    overflow: hidden;
  }

  .type-showcase::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold-medium), transparent);
  }

  .type-h1 {
    font-family: 'Cinzel Decorative', serif;
    font-size: 32px;
    font-weight: 700;
    color: var(--gold-ivory);
    line-height: 1.15;
    letter-spacing: 0.05em;
    text-shadow: 0 0 30px rgba(242, 232, 180, 0.25);
    margin-bottom: 6px;
  }

  .type-tagline {
    font-family: 'Cormorant', serif;
    font-size: 15px;
    font-style: italic;
    font-weight: 300;
    color: var(--copper-warm);
    letter-spacing: 0.15em;
    margin-bottom: 28px;
  }

  .type-h2 {
    font-family: 'Cinzel', serif;
    font-size: 18px;
    font-weight: 600;
    color: var(--gold-light);
    letter-spacing: 0.08em;
    margin-bottom: 6px;
  }

  .type-date {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.3em;
    color: var(--text-muted);
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .type-body {
    font-family: 'Cormorant Garamond', serif;
    font-size: 16px;
    font-weight: 400;
    color: var(--text-primary);
    line-height: 1.75;
    max-width: 600px;
    margin-bottom: 20px;
  }

  .type-body em {
    color: var(--gold-light);
    font-style: italic;
  }

  .type-caption {
    font-family: 'Cormorant Garamond', serif;
    font-size: 13px;
    color: var(--text-secondary);
    font-style: italic;
    letter-spacing: 0.04em;
  }

  .type-divider {
    height: 1px;
    background: var(--border-subtle);
    margin: 28px 0;
    position: relative;
  }

  .type-divider::after {
    content: '✦';
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    background: var(--bg-surface);
    padding: 0 12px;
    color: var(--gold-deep);
    font-size: 10px;
  }

  /* ─────────────────────────────────────────────
     COMPONENT SHOWCASE
  ───────────────────────────────────────────── */
  .component-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  @media (max-width: 640px) {
    .component-grid { grid-template-columns: 1fr; }
  }

  /* Buttons */
  .btn-showcase {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 32px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
  }

  .btn-label {
    font-family: 'Cinzel', serif;
    font-size: 9px;
    letter-spacing: 0.35em;
    color: var(--text-muted);
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 28px;
    font-family: 'Cinzel', serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    cursor: pointer;
    border: none;
    transition: all 0.25s ease;
    position: relative;
    overflow: hidden;
  }

  .btn::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.25s;
  }

  .btn:hover::before { opacity: 1; }

  .btn-primary {
    background: linear-gradient(135deg, var(--gold-main) 0%, var(--gold-light) 100%);
    color: var(--bg-void);
  }

  .btn-primary::before {
    background: linear-gradient(135deg, var(--gold-light) 0%, var(--gold-whisper) 100%);
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 24px rgba(208, 184, 74, 0.3);
  }

  .btn-accent {
    background: linear-gradient(135deg, var(--copper-warm) 0%, var(--copper-blaze) 100%);
    color: #F8F0D0;
  }

  .btn-accent::before {
    background: linear-gradient(135deg, var(--copper-blaze) 0%, #F08040 100%);
  }

  .btn-accent:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 24px rgba(232, 106, 40, 0.3);
  }

  .btn-ghost {
    background: transparent;
    color: var(--gold-light);
    border: 1px solid var(--gold-medium);
  }

  .btn-ghost::before {
    background: var(--glow-gold);
  }

  .btn-ghost:hover {
    border-color: var(--gold-light);
    color: var(--gold-ivory);
    box-shadow: 0 0 16px var(--glow-gold);
  }

  .btn-rose {
    background: transparent;
    color: var(--rose-blush);
    border: 1px solid var(--rose-main);
  }

  .btn-rose:hover {
    background: rgba(200, 120, 88, 0.1);
    border-color: var(--rose-blush);
    color: #F0D0C0;
  }

  /* Tags */
  .tags-showcase {
    padding: 32px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
  }

  .tags-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .tag {
    font-family: 'Cinzel', serif;
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 1px;
    transition: all 0.2s;
  }

  .tag-gold {
    background: rgba(208, 184, 74, 0.1);
    color: var(--gold-light);
    border: 1px solid rgba(208, 184, 74, 0.25);
  }

  .tag-copper {
    background: rgba(232, 106, 40, 0.1);
    color: var(--copper-blaze);
    border: 1px solid rgba(232, 106, 40, 0.25);
  }

  .tag-rose {
    background: rgba(200, 120, 88, 0.1);
    color: var(--rose-blush);
    border: 1px solid rgba(200, 120, 88, 0.25);
  }

  .tag-muted {
    background: var(--bg-raised);
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
  }

  /* Cards */
  .card-showcase {
    grid-column: 1 / -1;
  }

  .resume-card {
    padding: 36px 40px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    position: relative;
    transition: all 0.3s ease;
    overflow: hidden;
  }

  .resume-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 2px;
    height: 100%;
    background: linear-gradient(180deg, var(--gold-main), var(--copper-warm));
    opacity: 0;
    transition: opacity 0.3s;
  }

  .resume-card:hover {
    border-color: var(--border-glow);
    background: var(--bg-raised);
    transform: translateX(3px);
    box-shadow: -4px 0 24px rgba(208, 184, 74, 0.08);
  }

  .resume-card:hover::before {
    opacity: 1;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
    flex-wrap: wrap;
    gap: 8px;
  }

  .card-role {
    font-family: 'Cinzel', serif;
    font-size: 15px;
    font-weight: 600;
    color: var(--gold-light);
    letter-spacing: 0.05em;
  }

  .card-period {
    font-family: 'Cinzel', serif;
    font-size: 9px;
    letter-spacing: 0.25em;
    color: var(--text-muted);
    text-transform: uppercase;
    padding: 4px 10px;
    border: 1px solid var(--border-subtle);
    border-radius: 1px;
  }

  .card-company {
    font-family: 'Cormorant Garamond', serif;
    font-size: 13px;
    font-style: italic;
    color: var(--copper-warm);
    margin-bottom: 16px;
    letter-spacing: 0.05em;
  }

  .card-body {
    font-family: 'Cormorant Garamond', serif;
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 16px;
  }

  /* Progress / Skills */
  .skills-showcase {
    padding: 32px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
  }

  .skill-item {
    margin-bottom: 16px;
  }

  .skill-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 6px;
  }

  .skill-name {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--text-secondary);
    text-transform: uppercase;
  }

  .skill-level {
    font-family: 'Cormorant Garamond', serif;
    font-size: 12px;
    font-style: italic;
    color: var(--text-muted);
  }

  .skill-bar {
    height: 2px;
    background: var(--bg-hover);
    border-radius: 1px;
    overflow: hidden;
  }

  .skill-fill {
    height: 100%;
    border-radius: 1px;
    position: relative;
  }

  .skill-fill::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 5px;
    height: 5px;
    border-radius: 50%;
  }

  .fill-gold {
    background: linear-gradient(90deg, var(--gold-deep), var(--gold-main));
  }

  .fill-gold::after { background: var(--gold-ivory); box-shadow: 0 0 6px var(--gold-ivory); }

  .fill-copper {
    background: linear-gradient(90deg, var(--copper-amber), var(--copper-blaze));
  }

  .fill-copper::after { background: var(--copper-blaze); box-shadow: 0 0 6px var(--copper-blaze); }

  .fill-rose {
    background: linear-gradient(90deg, var(--rose-deep), var(--rose-main));
  }

  .fill-rose::after { background: var(--rose-blush); box-shadow: 0 0 6px var(--rose-blush); }

  /* ─────────────────────────────────────────────
     COLOR PHILOSOPHY SECTION
  ───────────────────────────────────────────── */
  .philosophy-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  @media (max-width: 640px) {
    .philosophy-grid { grid-template-columns: 1fr; }
  }

  .philosophy-card {
    padding: 28px 24px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    text-align: center;
    transition: all 0.25s;
  }

  .philosophy-card:hover {
    border-color: var(--border-glow);
    background: var(--bg-raised);
  }

  .philosophy-icon {
    font-size: 22px;
    margin-bottom: 16px;
    display: block;
  }

  .philosophy-name {
    font-family: 'Cinzel', serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .philosophy-desc {
    font-family: 'Cormorant Garamond', serif;
    font-size: 14px;
    font-style: italic;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* ─────────────────────────────────────────────
     USAGE RULES
  ───────────────────────────────────────────── */
  .rules-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .rule-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 18px 20px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 3px;
